<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                app:tint="@color/blue"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create New Task"
                android:textColor="@color/blue"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginEnd="32dp" />

        </LinearLayout>

        <!-- Task Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Title"
            style="@style/Text.Label.Primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/input_focus"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter task title..."
                android:inputType="text"
                android:maxLines="1"
                style="@style/Text.Body.Large" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Task Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            style="@style/Text.Label.Primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/input_focus"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe what needs to be done..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                style="@style/Text.Body.Large"
                android:gravity="top" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Payment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment (RM)"
            style="@style/Text.Label.Primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/input_focus"
            app:hintEnabled="false"
            app:prefixText="RM ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:maxLines="1"
                style="@style/Text.Body.Large" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Due Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Date"
            style="@style/Text.Label.Primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/dateClickArea"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/edittext_background"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/editTextDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select date"
                style="@style/Text.Body.Large"
                android:textColor="@color/placeholder_text" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                android:alpha="0.6"
                app:tint="@color/blue"/>

        </LinearLayout>

        <!-- Location -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            style="@style/Text.Label.Primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/locationClickArea"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/edittext_background"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/editTextLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap to select location"
                style="@style/Text.Body.Large"
                android:textColor="@color/placeholder_text" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:alpha="0.6"
                app:tint="@color/blue"/>

        </LinearLayout>

        <!-- Map Preview (Optional) -->
        <LinearLayout
            android:id="@+id/mapPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:background="@drawable/rounded_background_light"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <com.google.android.gms.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/white"
                style="@style/Text.Button.Secondary"
                android:background="@drawable/button_outline"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/blue"/>

            <Button
                android:id="@+id/btnCreateTask"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Create Task"
                android:textColor="@color/white"
                style="@style/Text.Button.Primary"
                android:background="@drawable/button_primary"
                android:layout_marginStart="8dp"
                app:backgroundTint="@color/blue"/>

        </LinearLayout>

        <!-- Bottom Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView> 