<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Badges &amp; Rewards"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Wallet Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/gradient_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Wallet"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/text_wallet_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RM0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/button_redeem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Withdraw to Bank"
                    android:textColor="@color/primary_color"
                    android:background="@android:color/white"
                    android:layout_marginTop="8dp"
                    style="@style/RoundedButton" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Beginner Badge -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/circle_background_light_green"
                        android:padding="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beginner Badge"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complete your first task"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reward: RM20"
                            android:textSize="12sp"
                            android:textColor="@color/success_color"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_beginner_tasks"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="12dp"
                    android:progress="100"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_yellow" />

                <Button
                    android:id="@+id/button_beginner_redeem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redeem"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"
                    style="@style/RoundedButton" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Employer Praise Badge -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_crown"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/circle_background_light_orange"
                        android:padding="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Employer Praise"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Receive excellent feedback"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reward: RM20"
                            android:textSize="12sp"
                            android:textColor="@color/success_color"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_employer_praise"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="12dp"
                    android:progress="100"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_yellow" />

                <Button
                    android:id="@+id/button_employer_praise_redeem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redeem"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"
                    style="@style/RoundedButton" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Consistent Performer Badge -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_medal"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/circle_background_light_purple"
                        android:padding="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Consistent Performer"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complete 5 tasks consistently"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reward: RM20"
                            android:textSize="12sp"
                            android:textColor="@color/success_color"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_consistent_performer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="12dp"
                    android:progress="100"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_yellow" />

                <Button
                    android:id="@+id/button_consistent_performer_redeem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redeem"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"
                    style="@style/RoundedButton" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView> 