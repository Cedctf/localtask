<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/primary_purple">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Tasks"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/myTasksSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading your tasks..."
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:alpha="0.8"/>

    </LinearLayout>

    <!-- Search Bar + Filter Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="120dp"
        android:padding="8dp"
        android:background="@color/purple_dark_bg">

        <SearchView
            android:id="@+id/searchViewMyTasks"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:queryHint="Search my tasks..."
            android:background="@drawable/edittext_background"
            android:layout_marginEnd="8dp"
            android:iconifiedByDefault="false"
            android:queryBackground="@android:color/transparent" />

                    <!-- Filter Button with Badge -->
            <RelativeLayout
                android:id="@+id/filterButtonContainerMyTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnFilterMyTasks"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_filter_list"
                    android:background="@drawable/button_primary_background"
                    android:contentDescription="Filter my tasks" />

                <TextView
                    android:id="@+id/filterBadgeMyTasks"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignTop="@id/btnFilterMyTasks"
                    android:layout_alignEnd="@id/btnFilterMyTasks"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/filter_badge_background"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone" />

            </RelativeLayout>

    </LinearLayout>

    <!-- Tasks List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/myTasksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="48sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Tasks Yet"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply for tasks from the Tasks tab to see them here"
            android:textSize="14sp"
            android:textColor="@color/text_gray"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Add Task FAB (only for hirers) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 