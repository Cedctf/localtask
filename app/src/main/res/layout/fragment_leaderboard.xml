<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Header Section -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_close"
        app:tint="@color/blue"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"/>

    <TextView
        android:id="@+id/leaderboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top Contributors"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textColor="@color/blue"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/notificationButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_notification"
        app:tint="@color/blue"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        android:layout_marginEnd="8dp"/>

    <!-- Time Period Tabs -->
    <LinearLayout
        android:id="@+id/timePeriodTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_toggle_background"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/leaderboardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabThisMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THIS MONTH"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/tab_modern_selected_background"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tabAllTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALL TIME"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:background="@android:color/transparent"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Podium Section using ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/podiumLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/timePeriodTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1st Place (Center) -->
        <LinearLayout
            android:id="@+id/firstPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="8dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/firstPlaceAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_profile"
                    android:padding="4dp"
                    app:strokeColor="@color/primary_yellow"
                    app:strokeWidth="3dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1st"
                    android:background="@drawable/progress_yellow"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_gravity="bottom|center_horizontal"/>
            </FrameLayout>

            <TextView
                android:id="@+id/firstPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="zehui"
                android:textColor="@color/blue"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/firstPlaceScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0"
                android:textColor="@color/text_secondary_gray"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 2nd Place -->
        <LinearLayout
            android:id="@+id/secondPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintEnd_toStartOf="@id/firstPlace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/firstPlace"
            android:layout_marginTop="24dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/secondPlaceAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_profile"
                    android:padding="4dp"
                    app:strokeColor="@color/light_gray"
                    app:strokeWidth="2dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2nd"
                    android:background="@drawable/rounded_background_light"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_gravity="bottom|center_horizontal"/>
            </FrameLayout>

            <TextView
                android:id="@+id/secondPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="kangyan"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/secondPlaceScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0"
                android:textColor="@color/text_secondary_gray"
                android:textSize="12sp"/>
        </LinearLayout>
        
        <!-- 3rd Place -->
        <LinearLayout
            android:id="@+id/thirdPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/firstPlace"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/firstPlace"
            android:layout_marginTop="24dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/thirdPlaceAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_profile"
                    android:padding="4dp"
                    app:strokeColor="@color/primary_bronze"
                    app:strokeWidth="2dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3rd"
                    android:background="@drawable/rounded_background_light"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_gravity="bottom|center_horizontal"/>
            </FrameLayout>

            <TextView
                android:id="@+id/thirdPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="zz"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/thirdPlaceScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0"
                android:textColor="@color/text_secondary_gray"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Rest of Leaderboard Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/podiumLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Corner.Large.Top"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Leaderboard RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/leaderboardRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_leaderboard_user"
                tools:itemCount="2"/>

            <!-- Call to Action -->
            <LinearLayout
                android:id="@+id/callToActionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_background_light"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_star"
                    android:background="@drawable/circle_background_light_purple"
                    android:padding="8dp"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Complete more tasks and start climbing the ranks."
                    style="@style/Text.Body.Medium"
                    android:textColor="@color/text_secondary_gray"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_email"
        app:backgroundTint="@color/blue"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout> 