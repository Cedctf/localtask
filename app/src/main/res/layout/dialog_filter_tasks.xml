<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/purple_dark_bg">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple_dark_bg">

        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            android:padding="16dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close filter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Tasks"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/clearAllButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear all"
            android:textColor="@color/primary_purple"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </RelativeLayout>

    <!-- Main Content Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/card_white">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Task Categories (Checkboxes) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Categories"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/categoryCleaningCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cleaning"
                        android:textColor="@color/text_grey"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/categoryTutoringCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tutoring"
                        android:textColor="@color/text_grey"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/categoryDeliveryCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery"
                        android:textColor="@color/text_grey"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/categorySmallTasksCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Small Tasks"
                        android:textColor="@color/text_grey"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Sort By (Dropdown) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort by"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <Spinner
                    android:id="@+id/sortBySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edittext_background"
                    android:layout_marginBottom="24dp" />
                    

                <!-- Distance (SeekBar 0-20km) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance:"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/distanceValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 km"
                        android:textColor="@color/primary_purple"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/distanceSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="10"
                    android:layout_marginBottom="24dp" />

                <!-- Payment Range (Radio Buttons) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Range"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <RadioGroup
                    android:id="@+id/paymentRangeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <RadioButton
                        android:id="@+id/paymentRangeAny"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Any Amount"
                        android:textColor="@color/text_grey"
                        android:checked="true"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/paymentRange1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 10 - RM 50"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/paymentRange2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 50 - RM 100"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/paymentRange3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 100 - RM 200"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/paymentRange4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 200+"
                        android:textColor="@color/text_grey" />

                </RadioGroup>

                <!-- Duration (Checkboxes) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duration"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/durationQuick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick (&lt; 2 hours)"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/durationHalfDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Half Day (2-4 hours)"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/durationFullDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Day (4+ hours)"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/durationMultiDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multi-day"
                        android:textColor="@color/text_grey" />

                </LinearLayout>

                <!-- Complexity (Checkboxes) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complexity"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/complexityBeginner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beginner friendly"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/complexityExperience"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requires experience"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/complexityProfessional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Professional skills needed"
                        android:textColor="@color/text_grey" />

                </LinearLayout>

                <!-- Areas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Areas"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/areaSubangJaya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subang Jaya"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/areaPetalingJaya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Petaling Jaya"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/areaShahAlam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shah Alam"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/areaKlangValley"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Klang Valley"
                        android:textColor="@color/text_grey" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/applyFiltersButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Apply Filters"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_purple"
        app:cornerRadius="28dp"
        android:elevation="8dp"
        android:layout_margin="16dp" />

</LinearLayout> 