<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_white">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Activity Icon -->
    <ImageView
        android:id="@+id/activityIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_notification"
        android:background="@drawable/circle_background_light_green"
        android:padding="8dp"
        android:layout_marginEnd="16dp"/>

    <!-- Activity Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/activityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Completed"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/activityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="House cleaning task finished successfully"
            android:textSize="14sp"
            android:textColor="@color/text_grey"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"/>

    </LinearLayout>

    <!-- Time and Amount -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/activityAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+RM 80"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/success_green"/>

        <TextView
            android:id="@+id/activityTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 hours ago"
            android:textSize="14sp"
            android:textColor="@color/text_grey"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

</LinearLayout>

</com.google.android.material.card.MaterialCardView>