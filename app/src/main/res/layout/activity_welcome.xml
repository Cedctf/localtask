<?xml version="1.0" encoding="utf-8"?>
<!--
    This XML layout file defines the welcome screen for the LocalTask Android application.
    It incorporates the modern gradient design with animated elements container while
    preserving the existing Login and Sign Up functionality.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WelcomeActivity">

    <!--
        Background View:
        This view displays the gradient background that creates the modern look
    -->
    <View
        android:id="@+id/background_gradient_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Placeholder for Circular Interactive/Animated Elements:
        This FrameLayout acts as a container for future animated elements
        (starburst, orbiting icons, etc.) that can be added later
    -->
    <FrameLayout
        android:id="@+id/animated_elements_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/content_section_guideline"
        android:layout_marginTop="?attr/actionBarSize">
        
        <!-- Task Checklist Icon in the center -->
        <ImageView
            android:id="@+id/center_task_icon"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@drawable/task_checklist_icon"
            android:contentDescription="LocalTask app icon"
            android:scaleType="fitCenter" />
            
        <!-- Custom animated views will go here in future iterations -->
    </FrameLayout>

    <!-- Guideline to position the content section in the lower half -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/content_section_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <!--
        Content Section: Contains the branding and app information
    -->
    <LinearLayout
        android:id="@+id/content_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@+id/content_section_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttons_container"
        app:layout_constraintVertical_bias="0.3">

        <!-- Brand Logo Text -->
        <TextView
            android:id="@+id/luma_logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LocalTask"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="sans-serif-light"
            android:alpha="0.9"
            android:layout_marginBottom="8dp" />

        <!-- Main Headline -->
        <TextView
            android:id="@+id/headline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delightful Tasks"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Sub-headline -->
        <TextView
            android:id="@+id/sub_headline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Here"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:alpha="0.95"
            android:layout_marginBottom="16dp" />

        <!-- App Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Where hirers post tasks and\nusers complete them to earn money"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:alpha="0.8"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!--
        Buttons Container: Contains the Login and Sign Up buttons
    -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1.0">

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Log In"
            android:textColor="@color/primary_purple"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/white"
            app:cornerRadius="28dp"
            android:elevation="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sign Up"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 