<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Account"
                    android:textColor="@color/blue"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textSize="28sp"/>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/default_profile"
                    android:background="@drawable/circle_background_light_grey"
                    android:padding="8dp"/>

            </LinearLayout>

            <!-- Cash Balance Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Card.Modern"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Cash Balance Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cash Balance"
                            style="@style/TextAppearance.Modern.Headline.Medium"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account &amp; Routing"
                            style="@style/TextAppearance.Modern.Body.Medium"
                            android:textColor="@color/text_secondary_gray"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:padding="8dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"
                            android:layout_marginStart="4dp"/>

                    </LinearLayout>

                    <!-- Cash Amount -->
                    <TextView
                        android:id="@+id/cashBalanceAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM0.00"
                        android:textSize="48sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:textColor="@color/blue"
                        android:layout_marginBottom="24dp"/>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addCashButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Add Cash"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="visible"
                            app:backgroundTint="#000000"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cashOutButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Cash Out"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="visible"
                            app:backgroundTint="#000000"
                            app:cornerRadius="8dp"
                            android:layout_marginStart="8dp"/>

                </LinearLayout>

            </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Feature Cards - Vertical Rectangle Banners -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Leaderboard Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/leaderboardCard"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_leaderboard"
                            android:background="@drawable/circle_background_light_orange"
                            android:padding="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Leaderboard"
                                android:textColor="#007AFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:visibility="visible"/>

                            <TextView
                                android:id="@+id/leaderboardSubtext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View rankings"
                                android:textColor="#007AFF"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:visibility="visible"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Search Tasks Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/searchCard"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_search"
                            android:background="@drawable/circle_background_light_blue"
                            android:padding="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Search Tasks"
                                android:textColor="#007AFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:visibility="visible"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Find available tasks"
                                android:textColor="#007AFF"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:visibility="visible"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- My Tasks Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/myTasksCard"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_my_tasks"
                            android:background="@drawable/circle_background_light_purple"
                            android:padding="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Tasks"
                                android:textColor="#007AFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:visibility="visible"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Track progress"
                                android:textColor="#007AFF"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:visibility="visible"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Badges Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badgesCard"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:background="@drawable/circle_background_light_orange"
                                android:src="@drawable/ic_badge"
                                android:padding="8dp"/>

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Badges"
                                android:textColor="#007AFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:visibility="visible"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Earn rewards"
                                android:textColor="#007AFF"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:visibility="visible"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_crown"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Quick Stats Bar (Optional) -->
            <LinearLayout
                android:id="@+id/quickStatsBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/rounded_background_light"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/activeTasksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/TextAppearance.Modern.Headline.Medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        style="@style/TextAppearance.Modern.Body.Small"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="@color/text_secondary"
                    android:alpha="0.3"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                    android:gravity="center">

                        <TextView
                        android:id="@+id/completedTasksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/TextAppearance.Modern.Headline.Medium"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        android:text="Completed"
                        style="@style/TextAppearance.Modern.Body.Small"/>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="@color/text_secondary"
                    android:alpha="0.3"/>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                        android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pointsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/TextAppearance.Modern.Headline.Medium"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        android:text="Points"
                        style="@style/TextAppearance.Modern.Body.Small"/>

                    </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="@color/text_secondary"
                    android:alpha="0.3"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                        android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/levelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        style="@style/TextAppearance.Modern.Headline.Medium"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        android:text="Level"
                        style="@style/TextAppearance.Modern.Body.Small"/>

                    </LinearLayout>

            </LinearLayout>

            <!-- Section Header for Task List -->
            <TextView
                android:id="@+id/taskListHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Tasks"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <!-- RecyclerView for Task List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeTaskRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:overScrollMode="never"
                android:clipToPadding="false"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout> 