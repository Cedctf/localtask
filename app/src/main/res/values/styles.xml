<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- === MODERN TYPOGRAPHY SYSTEM === -->
    
    <!-- Display Text Styles -->
    <style name="TextAppearance.Modern.Display.Large">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Modern.Display.Medium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Modern.Display.Small">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Headline Text Styles -->
    <style name="TextAppearance.Modern.Headline.Large">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Modern.Headline.Medium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Modern.Headline.Small">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Body Text Styles -->
    <style name="TextAppearance.Modern.Body.Large">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.Modern.Body.Medium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Modern.Body.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_gray</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Label Text Styles -->
    <style name="TextAppearance.Modern.Label.Large">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Modern.Label.Medium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Modern.Label.Small">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary_gray</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- === MODERN BUTTON STYLES === -->
    
    <!-- Primary Button (Black) -->
    <style name="Button.Modern.Primary">
        <item name="android:background">@drawable/button_modern_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Label.Large</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Secondary Button (Gray) -->
    <style name="Button.Modern.Secondary">
        <item name="android:background">@drawable/button_modern_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Label.Large</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Text Button (Blue) -->
    <style name="Button.Modern.Text">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Label.Large</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Small Button -->
    <style name="Button.Modern.Small">
        <item name="android:background">@drawable/button_modern_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Label.Medium</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- === MODERN CARD STYLES === -->
    
    <style name="Card.Modern">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/background_white</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="Card.Modern.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/background_white</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">24dp</item>
    </style>

    <style name="Card.Modern.Dark">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/background_dark_card</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">20dp</item>
    </style>

    <!-- === INPUT FIELD STYLES === -->
    
    <style name="EditText.Modern">
        <item name="android:background">@drawable/edittext_modern_background</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Body.Medium</item>
        <item name="android:textColor">@color/text_primary_black</item>
        <item name="android:textColorHint">@color/text_tertiary_light_gray</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- === TAB STYLES === -->
    
    <style name="Tab.Modern">
        <item name="android:background">@drawable/tab_modern_background</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Label.Medium</item>
        <item name="android:textColor">@color/text_secondary_gray</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Tab.Modern.Selected">
        <item name="android:background">@drawable/tab_modern_selected_background</item>
        <item name="android:textColor">@color/text_primary_black</item>
    </style>

    <!-- === MISSING BASE STYLES (Fix for compilation errors) === -->
    
    <!-- Base styles that might be referenced by incomplete names -->
    <style name="Button.Modern" parent="Button.Modern.Primary" />
    <style name="Card" parent="Card.Modern" />
    <style name="EditText" parent="EditText.Modern" />
    <style name="Tab" parent="Tab.Modern" />
    <style name="BottomNavigation" parent="BottomNavigation.Modern" />
    <style name="FloatingActionButton" parent="FloatingActionButton.Modern" />
    <style name="TextAppearance.Modern.Body" parent="TextAppearance.Modern.Body.Medium" />
    <style name="TextAppearance.Modern.Display" parent="TextAppearance.Modern.Display.Small" />
    <style name="TextAppearance.Modern.Headline" parent="TextAppearance.Modern.Headline.Medium" />
    <style name="TextAppearance.Modern.Label" parent="TextAppearance.Modern.Label.Large" />
    <style name="Toolbar" parent="Toolbar.Modern" />

    <!-- Additional missing text styles for layout compatibility -->
    <style name="Text.Heading.Medium" parent="TextAppearance.Modern.Headline.Medium" />
    <style name="Text.Label.Primary" parent="TextAppearance.Modern.Label.Large" />
    <style name="Text.Body.Large" parent="TextAppearance.Modern.Body.Large" />
    <style name="Text.Button.Secondary" parent="TextAppearance.Modern.Label.Large" />
    <style name="Text.Button.Primary" parent="TextAppearance.Modern.Label.Large" />
    <style name="Text.Heading.Large" parent="TextAppearance.Modern.Display.Large" />
    <style name="Text.Heading.Small" parent="TextAppearance.Modern.Headline.Small" />
    <style name="Text.Inverse.Body" parent="TextAppearance.Modern.Body.Medium">
        <item name="android:textColor">@color/text_white</item>
    </style>
    <style name="Text.Inverse.Heading" parent="TextAppearance.Modern.Headline.Medium">
        <item name="android:textColor">@color/text_white</item>
    </style>
    <style name="Text.Label.Secondary" parent="TextAppearance.Modern.Label.Medium">
        <item name="android:textColor">@color/text_secondary_gray</item>
    </style>
    <style name="Text.Body.Medium" parent="TextAppearance.Modern.Body.Medium" />
    <style name="Text.Caption" parent="TextAppearance.Modern.Label.Small">
        <item name="android:textColor">@color/text_secondary_gray</item>
    </style>
    <style name="Text.Tab.Active" parent="TextAppearance.Modern.Label.Medium">
        <item name="android:textColor">@color/accent_blue</item>
    </style>
    <style name="Text.Tab.Inactive" parent="TextAppearance.Modern.Label.Medium">
        <item name="android:textColor">@color/text_secondary_gray</item>
    </style>
    <style name="Text.Status.Success" parent="TextAppearance.Modern.Label.Small">
        <item name="android:textColor">@color/accent_success_green</item>
    </style>
    <style name="Text.Body.Small" parent="TextAppearance.Modern.Body.Small" />

    <!-- === LEGACY COMPATIBILITY STYLES === -->
    
    <!-- Base Application Theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_black</item>
        <item name="colorPrimaryDark">@color/primary_dark_gray</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/background_white</item>
        <item name="android:textColorPrimary">@color/text_primary_black</item>
        <item name="android:textColorSecondary">@color/text_secondary_gray</item>
    </style>

    <!-- No Action Bar Theme -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Full Screen Theme -->
    <style name="AppTheme.FullScreen" parent="AppTheme.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Legacy Button Style -->
    <style name="ButtonStyle" parent="@style/Button.Modern.Primary" />

    <!-- Legacy Text Styles -->
    <style name="TitleTextStyle" parent="@style/TextAppearance.Modern.Display.Small" />
    <style name="HeadlineTextStyle" parent="@style/TextAppearance.Modern.Headline.Medium" />
    <style name="BodyTextStyle" parent="@style/TextAppearance.Modern.Body.Medium" />
    <style name="CaptionTextStyle" parent="@style/TextAppearance.Modern.Body.Small" />

    <!-- Toolbar Styles -->
    <style name="Toolbar.Modern">
        <item name="android:background">@color/background_white</item>
        <item name="android:elevation">2dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.Modern.Headline.Medium</item>
        <item name="titleTextColor">@color/text_primary_black</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="BottomNavigation.Modern">
        <item name="android:background">@color/background_white</item>
        <item name="android:elevation">8dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Modern.Label.Small</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Modern.Label.Small</item>
        <item name="itemTextColor">@color/text_secondary_gray</item>
        <item name="itemIconTint">@color/text_secondary_gray</item>
    </style>

    <!-- Floating Action Button Style -->
    <style name="FloatingActionButton.Modern">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">@color/button_primary_black</item>
        <item name="tint">@color/text_white</item>
        <item name="elevation">6dp</item>
        <item name="pressedTranslationZ">12dp</item>
    </style>

    <!-- === ENHANCED FONT STYLES FOR BLUE THEME === -->
    
    <!-- Base TextAppearance style -->
    <style name="TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@android:color/black</item>
    </style>
    
    <!-- Base style for LocalTask -->
    <style name="TextAppearance.LocalTask">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/blue</item>
    </style>
    
    <!-- Primary font family for headers -->
    <style name="TextAppearance.LocalTask.Header">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Secondary font family for body text -->
    <style name="TextAppearance.LocalTask.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Tertiary font family for captions -->
    <style name="TextAppearance.LocalTask.Caption">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:alpha">0.8</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Button text style -->
    <style name="TextAppearance.LocalTask.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="ShapeAppearance.App.Corner.Large.Top" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources> 