<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with modern design system -->
    <style name="Base.Theme.Assignment2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Modern color scheme -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_purple_dark_new</item>
        <item name="colorAccent">@color/primary_purple</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/primary_purple</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <item name="colorSurface">@color/background_white</item>
        <item name="colorOnSurface">@color/text_primary_black</item>
        <item name="android:colorBackground">@color/background_white</item>
        <item name="colorOnBackground">@color/text_primary_black</item>
        
        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary_black</item>
        <item name="android:textColorSecondary">@color/text_secondary_gray</item>
        <item name="android:textColorTertiary">@color/text_tertiary_light_gray</item>
        <item name="android:fontFamily">sans-serif</item>
        
        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        
        <!-- Status bar configuration -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.Assignment2" parent="Base.Theme.Assignment2" />
</resources>